# Выбери одного провайдера: groq или openrouter.
LLM_PROVIDER=groq

# Нужен только ключ выбранного провайдера.
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini
OPENROUTER_API_KEY=

# Цена выбранной модели в USD за 1 млн токенов.
# Укажи актуальные значения перед финальным замером стоимости.
LLM_INPUT_PRICE_PER_MILLION=0.0
LLM_OUTPUT_PRICE_PER_MILLION=0.0