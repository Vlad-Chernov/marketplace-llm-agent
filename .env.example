# Выбери одного провайдера: groq, openrouter или gigachat.
LLM_PROVIDER=groq

# Нужен только ключ выбранного провайдера.
GROQ_API_KEY=
GROQ_MODEL=groq/compound-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_MODEL=GigaChat-2-Pro

# Цена выбранной модели в USD за 1 млн токенов.
LLM_INPUT_PRICE_PER_MILLION=0.0
LLM_OUTPUT_PRICE_PER_MILLION=0.0